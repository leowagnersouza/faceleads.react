# API base URL for the React client (Vite)
# In production, set this to your remote endpoint.
# In development, if unset, the app falls back to http://localhost:5293
# Do not include a trailing slash.
# Example (Azure Websites dev):
# VITE_API_BASE_URL=https://faceleads-api-dev.azurewebsites.net
VITE_API_BASE_URL=https://api.seu-dominio.com